<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ConversationManager.UiTests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <!--
    Layout checks for the two UI pieces that are easy to break invisibly: the search box's
    placeholder alignment, and the run-splitting that highlights a match inside a snippet.
    Both need WPF, hence a separate project from ConversationManager.Tests.

    The app's Theme.xaml and Converters.cs are compiled in directly rather than referenced,
    because the app is published self-contained and a self-contained exe cannot be referenced.
    Linking the real files (not copies) means these tests fail if either regresses.
    Nothing is ever shown: elements are measured, arranged and rendered offscreen.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\ConversationManager\Converters.cs" Link="Converters.cs" />
    <Page Include="..\..\src\ConversationManager\Theme.xaml" Link="Theme.xaml" />
  </ItemGroup>

</Project>
