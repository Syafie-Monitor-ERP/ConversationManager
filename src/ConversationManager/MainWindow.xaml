<Window x:Class="ConversationManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ConversationManager"
        xmlns:vm="clr-namespace:ConversationManager.ViewModels"
        Title="Conversation Manager"
        Icon="app.ico"
        Height="880" Width="1180" MinHeight="520" MinWidth="820"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding ReloadCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- One conversation. The same card serves a search hit and the overview: the only
             difference is whether the snippet line is showing a match or the opening prompt. -->
        <DataTemplate DataType="{x:Type vm:ConversationCardViewModel}">
            <Border x:Name="Root" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">

                        <!-- Title and age -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Title}" />
                            <TextBlock Grid.Column="1" Text="{Binding AgeText}"
                                       Style="{StaticResource Label}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </Grid>

                        <!-- Branch · folder · size. The branch is what the search usually was. -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding BranchText}"
                                       Foreground="{StaticResource Accent}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="300"
                                       ToolTip="{Binding BranchTooltip}" />
                            <Border Style="{StaticResource Pill}" Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasExtraBranches, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ExtraBranchText}" Style="{StaticResource Label}"
                                           ToolTip="{Binding BranchTooltip}" />
                            </Border>
                            <TextBlock Text="  ·  " Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FolderName}" Style="{StaticResource Label}"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding FolderPath}" />
                            <TextBlock Text="  ·  " Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Label}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Why this card is here: the matched words, in context -->
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MatchLabel" Text="{Binding MatchLabel}"
                                           Style="{StaticResource Label}"
                                           Foreground="{Binding IsDeepMatch, Converter={StaticResource DeepBrush}}" />
                                <TextBlock Text="   " Style="{StaticResource Label}" />
                                <TextBlock Text="{Binding OtherHitsText}" Style="{StaticResource Label}" />
                            </StackPanel>
                            <!-- Inlines, not Text: the matched words are picked out by Highlight -->
                            <TextBlock FontSize="12" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SnippetText}"
                                       local:Highlight.Text="{Binding SnippetText}"
                                       local:Highlight.Start="{Binding SnippetMatchStart}"
                                       local:Highlight.Length="{Binding SnippetMatchLength}"
                                       local:Highlight.Brush="{StaticResource Hit}" />
                        </StackPanel>

                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource Mono}" Margin="0,7,0,0" />

                        <!-- Half a conversation is still worth finding, but say which half -->
                        <TextBlock Text="{Binding SourceNote}"
                                   Foreground="{StaticResource Amber}" FontSize="11" Margin="0,5,0,0"
                                   Visibility="{Binding IsHistoryOnly, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{Binding Message}"
                                   Foreground="{Binding MessageIsError, Converter={StaticResource MessageBrush}}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Preview" Style="{StaticResource ButtonBase}"
                                    Command="{Binding PreviewCommand}"
                                    ToolTip="Read this conversation without resuming it" />
                            <Button Content="Resume" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ResumeCommand}"
                                    ToolTip="Open a terminal in that folder running claude --resume" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Explorer" Style="{StaticResource LinkButton}"
                                    Command="{Binding ExplorerCommand}" />
                            <Button Content="Terminal" Style="{StaticResource LinkButton}"
                                    Command="{Binding TerminalCommand}" />
                            <Button Content="Copy id" Style="{StaticResource LinkButton}"
                                    Command="{Binding CopyIdCommand}"
                                    ToolTip="{Binding ShortId}" />
                            <Button Content="Copy resume cmd" Style="{StaticResource LinkButton}"
                                    Command="{Binding CopyResumeCommand}" />
                            <!-- Last, and set apart: the only button here that cannot be undone -->
                            <Border Width="1" Margin="6,4" Background="{StaticResource BorderBrushSoft}" />
                            <Button Content="Delete" Style="{StaticResource DangerLinkButton}"
                                    Command="{Binding DeleteCommand}"
                                    ToolTip="Remove the transcript and this session's prompts from history" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Evidence from command output gets a quieter card than evidence from a prompt -->
                <DataTrigger Binding="{Binding IsDeepMatch}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHistoryOnly}" Value="True">
                    <Setter TargetName="Root" Property="BorderBrush" Value="#FF4A4436" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One group heading in the overview, with its conversations beneath -->
        <DataTemplate DataType="{x:Type vm:ConversationGroupViewModel}">
            <StackPanel Margin="0,0,0,20">
                <Grid Margin="0,0,0,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="620" />
                        <Border Style="{StaticResource Pill}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Label}" />
                        </Border>
                    </StackPanel>
                    <!-- Clearing out a whole branch or a whole day, which is the reason most
                         people open this tool twice. -->
                    <Button Content="{Binding DeleteAllText}" Style="{StaticResource DangerLinkButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Command="{Binding DeleteAllCommand}"
                            ToolTip="Delete every conversation under this heading" />
                </Grid>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mono}" Margin="0,0,0,9"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}"
                           Visibility="{Binding Subtitle, Converter={StaticResource TextToVis}}" />
                <ItemsControl ItemsSource="{Binding Cards}" />
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Conversation Manager"
                           Style="{StaticResource H1}" VerticalAlignment="Center"
                           Margin="0,0,24,0" />

                <!-- Stretch, not Left: sized to the column so the box does not resize as you type -->
                <Grid Grid.Column="1" MaxWidth="620" HorizontalAlignment="Stretch" Margin="0,0,20,0">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource PlaceholderTextBox}"
                             Tag="Which conversation was that?  A branch, a PR number, or something you said..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Padding="10,8,30,8" />
                    <Button Content="✕" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Right" Margin="0,0,6,0"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchText, Converter={StaticResource TextToVis}}" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Search" Style="{StaticResource Label}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Border Style="{StaticResource SegmentStrip}" VerticalAlignment="Center"
                            ToolTip="Your prompts are 0.06MB of the store and answer most questions. Everything adds Claude's replies and command output - 22MB of build logs and file dumps.">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="your prompts" Style="{StaticResource SegmentButton}"
                                    Tag="{Binding IsScopePrompts}"
                                    Command="{Binding SetScopeCommand}" CommandParameter="prompts" />
                            <Button Content="everything" Style="{StaticResource SegmentButton}"
                                    Tag="{Binding IsScopeEverything}"
                                    Command="{Binding SetScopeCommand}" CommandParameter="everything" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Group by" Style="{StaticResource Label}"
                               VerticalAlignment="Center" Margin="14,0,6,0" />
                    <Border Style="{StaticResource SegmentStrip}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="branch" Style="{StaticResource SegmentButton}"
                                    Tag="{Binding IsGroupByBranch}"
                                    Command="{Binding SetGroupCommand}" CommandParameter="branch" />
                            <Button Content="folder" Style="{StaticResource SegmentButton}"
                                    Tag="{Binding IsGroupByFolder}"
                                    Command="{Binding SetGroupCommand}" CommandParameter="folder" />
                            <Button Content="recent" Style="{StaticResource SegmentButton}"
                                    Tag="{Binding IsGroupByRecent}"
                                    Command="{Binding SetGroupCommand}" CommandParameter="recent" />
                        </StackPanel>
                    </Border>

                    <Button Content="Rescan" Style="{StaticResource ButtonBase}" Margin="14,0,0,0"
                            Command="{Binding ReloadCommand}"
                            ToolTip="Read the .claude folder again (F5)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nothing to search: say where it looked, not just that it found nothing -->
        <Border Grid.Row="1" Background="#FF3A2F22" BorderBrush="{StaticResource Amber}"
                BorderThickness="0,0,0,1" Padding="20,10"
                Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Amber}"
                       TextWrapping="Wrap" FontSize="12" />
        </Border>

        <!-- Content -->
        <Grid Grid.Row="2">

            <!-- Search results -->
            <Grid Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,16,24,10">
                    <TextBlock Text="{Binding SearchSummary}" Style="{StaticResource Label}"
                               VerticalAlignment="Center" />
                    <!-- The query is a way of picking a set, so it is also a way of deleting one -->
                    <Button Content="{Binding DeleteResultsText}"
                            Style="{StaticResource DangerLinkButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding DeleteResultsCommand}"
                            Visibility="{Binding CanDeleteResults, Converter={StaticResource BoolToVis}}"
                            ToolTip="Delete every conversation in this list" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,10">
                    <ItemsControl ItemsSource="{Binding Results}" />
                </ScrollViewer>

                <!-- The 22MB of command output, offered rather than mixed in -->
                <Border Grid.Row="2" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                        Padding="24,8"
                        Visibility="{Binding HasDeepSummary, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DeepSummary}" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" />
                        <Button Content="show" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                Command="{Binding ShowDeepCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Overview -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,14,20"
                          Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisInv}}">
                <ItemsControl ItemsSource="{Binding Groups}" />
            </ScrollViewer>

        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Label}" />
                <TextBlock Style="{StaticResource Label}" HorizontalAlignment="Right"
                           Text="Ctrl+F search   ·   Esc clear   ·   F5 rescan" />
            </Grid>
        </Border>

    </Grid>
</Window>
